{
  "name": "hambazi",
  "version": "0.0.0",
  "private": true,
  "description": "A multiplayer game hub for Telegram Bot and Telegram Mini App.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.4.1"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@hambazi/eslint": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}
