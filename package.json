{
  "name": "hambazi",
  "version": "0.0.0",
  "private": true,
  "description": "A multiplayer game hub for Telegram Bot and Telegram Mini App.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "12.4.1"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm check:architecture && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @hambazi/api contract:check",
    "check:architecture": "node tooling/eslint/check-architecture.mjs",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:infra",
    "test:infra": "vitest run infra",
    "test:auth:local": "turbo run build --filter=@hambazi/worker --filter=@hambazi/bot && pnpm --filter @hambazi/database test:local --api-auth",
    "test:auth-http:local": "node infra/scripts/test-auth-http-local.mjs",
    "infra:env": "node infra/scripts/create-local-env.mjs",
    "infra:config": "docker compose --env-file .env --file infra/docker/compose.yaml config --quiet",
    "infra:up": "docker compose --env-file .env --file infra/docker/compose.yaml up --detach --wait --wait-timeout 90",
    "infra:down": "docker compose --env-file .env --file infra/docker/compose.yaml down",
    "infra:status": "docker compose --env-file .env --file infra/docker/compose.yaml ps",
    "laptop:start": "node infra/scripts/laptop-server.mjs start",
    "laptop:status": "node infra/scripts/laptop-server.mjs status",
    "laptop:stop": "node infra/scripts/laptop-server.mjs stop"
  },
  "devDependencies": {
    "@hambazi/eslint": "workspace:*",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "vitest": "5.0.0",
    "yaml": "2.9.1",
    "turbo": "2.10.12"
  }
}
