# Public API origin only. Never put credentials or Telegram initData in VITE_* values.
# If omitted, the browser uses the Mini App's own origin (same-origin reverse proxy).
VITE_API_ORIGIN=http://127.0.0.1:3000

# For an isolated synthetic local UI, run pnpm --filter @hambazi/web dev:preview.
# That command overrides this origin with its own loopback fixture.
