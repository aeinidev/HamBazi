# Public API origin only. Never put credentials or Telegram initData in VITE_* values.
# If omitted, the browser uses the Mini App's own origin (same-origin reverse proxy).
VITE_API_ORIGIN=http://127.0.0.1:3000

# For an isolated synthetic local UI, run pnpm --filter @hambazi/web dev:preview.
# That command overrides this origin with its own loopback fixture.

# Ordinary build defaults to strict production policy: this HTTP development
# origin must be omitted (same-origin) or replaced with an approved HTTPS origin.
# Public browser-policy inputs; see docs/security/browser-policy.md.
# HAMBAZI_WEB_ORIGIN=https://APPROVED_MINI_APP_ORIGIN
# HAMBAZI_WEB_FRAME_ANCESTORS=[]
# HAMBAZI_WEB_POLICY_PROFILE=production
# Explicit loopback-test builds also require a loopback HAMBAZI_WEB_ORIGIN.
# Never deploy a loopback-test security-headers.json artifact.
