{
  "name": "@hambazi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:preview": "node dev/preview.mjs",
    "build": "tsc --project tsconfig.build.json && vite build && node dev/check-preview-boundary.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run tests/unit",
    "test:browser": "playwright test",
    "test:preview": "playwright test --config preview.playwright.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@hambazi/typescript": "workspace:*",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.13.4",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "socket.io": "4.8.3"
  },
  "dependencies": {
    "@hambazi/contracts": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-query": "5.104.0",
    "zustand": "5.0.15",
    "socket.io-client": "4.8.3",
    "zod": "4.6.2"
  }
}
