{
  "name": "@hambazi/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "start": "node dist/composition/main.js",
    "stats:rebuild": "node dist/composition/rebuild-statistics.js"
  },
  "dependencies": {
    "@hambazi/api": "workspace:*",
    "@hambazi/config": "workspace:*",
    "@hambazi/database": "workspace:*",
    "bullmq": "6.3.8",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@hambazi/typescript": "workspace:*",
    "@types/node": "24.13.4",
    "vitest": "5.0.0",
    "typescript": "6.0.3"
  }
}
