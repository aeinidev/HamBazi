{
  "name": "@hambazi/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "start": "node dist/composition/main.js"
  },
  "dependencies": {
    "@hambazi/api": "workspace:*",
    "@hambazi/config": "workspace:*",
    "@hambazi/contracts": "workspace:*",
    "@hambazi/observability": "workspace:*",
    "fastify": "5.12.5",
    "grammy": "1.46.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@hambazi/typescript": "workspace:*",
    "@types/node": "24.13.4",
    "@types/node-fetch": "2.6.13",
    "vitest": "5.0.0",
    "typescript": "6.0.3"
  }
}
