{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@hambazi/database#typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@hambazi/api#test": {
      "dependsOn": ["typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/contracts/auth.v1.baseline.json",
        "$TURBO_ROOT$/docs/contracts/bot-internal.v1.baseline.json",
        "$TURBO_ROOT$/docs/contracts/profile.v1.baseline.json",
        "$TURBO_ROOT$/docs/contracts/catalog.v1.baseline.json",
        "$TURBO_ROOT$/docs/contracts/rooms.v1.baseline.json",
        "$TURBO_ROOT$/docs/contracts/realtime.v1.baseline.json",
        "$TURBO_ROOT$/docs/contracts/realtime.delivery.v1.baseline.json"
      ],
      "outputs": []
    },
    "@hambazi/eslint#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/games/*/package.json",
        "$TURBO_ROOT$/tooling/*/package.json",
        "$TURBO_ROOT$/packages/database/prisma/schema.prisma",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/apps/*/tsconfig*.json",
        "$TURBO_ROOT$/packages/*/tsconfig*.json",
        "$TURBO_ROOT$/packages/games/*/tsconfig*.json",
        "$TURBO_ROOT$/tooling/typescript/*.json"
      ],
      "outputs": []
    }
  }
}
