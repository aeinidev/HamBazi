[Unit]
Description=Contain restricted staging when exact-image security evidence expires
After=docker.service nginx.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/hambazi/ops/replacement-security.py --contain
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hambazi/security /etc/nginx/sites-available/hambazi /var/log/nginx /run
