[Unit]
Description=HamBazi SSH-only Admin
After=docker.service network-online.target
Requires=docker.service
Conflicts=hambazi-server-security-contain.service hambazi-admin-security-contain.service

[Service]
Type=simple
UMask=0077
ExecStartPre=/usr/bin/python3 /opt/hambazi/admin/ops/admin-security.py --admit
ExecStart=/usr/bin/docker start --attach hambazi-admin-api
ExecStop=/usr/bin/docker stop --time 15 hambazi-admin-api
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
