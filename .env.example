# Documentation only. Run pnpm infra:env to generate distinct local credentials.
# Never use these placeholders or this local topology in production.
NODE_ENV=development
API_PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_HOST_PORT=5432
# Optional fresh named volume for an operator-reviewed logical image transition.
# POSTGRES_DATA_VOLUME=hambazi-local-postgres-remediated
REDIS_HOST_PORT=6379
POSTGRES_PASSWORD=REPLACE_ADMIN_PASSWORD
POSTGRES_API_PASSWORD=REPLACE_API_PASSWORD
POSTGRES_WORKER_PASSWORD=REPLACE_WORKER_PASSWORD
POSTGRES_MIGRATOR_PASSWORD=REPLACE_MIGRATOR_PASSWORD
REDIS_API_PASSWORD=REPLACE_REDIS_API_PASSWORD
REDIS_WORKER_PASSWORD=REPLACE_REDIS_WORKER_PASSWORD
REDIS_HEALTH_PASSWORD=REPLACE_REDIS_HEALTH_PASSWORD
API_DATABASE_URL=postgresql://hambazi_api:REPLACE_API_PASSWORD@localhost:5432/hambazi
WORKER_DATABASE_URL=postgresql://hambazi_worker:REPLACE_WORKER_PASSWORD@localhost:5432/hambazi
MIGRATION_DATABASE_URL=postgresql://hambazi_migrator:REPLACE_MIGRATOR_PASSWORD@localhost:5432/hambazi
API_REDIS_URL=redis://api:REPLACE_REDIS_API_PASSWORD@localhost:6379/0
WORKER_REDIS_URL=redis://worker:REPLACE_REDIS_WORKER_PASSWORD@localhost:6379/0

# Optional Worker outbox dispatcher. Disabled until explicitly configured.
# MATCH_OUTBOX_ENABLED=false
# When true, set every MATCH_OUTBOX_* policy below; see docs/architecture/match-outbox.md.
# MATCH_OUTBOX_INTERVAL_MS=
# MATCH_OUTBOX_BATCH_SIZE=
# MATCH_OUTBOX_LEASE_MS=
# MATCH_OUTBOX_ATTEMPTS=
# MATCH_OUTBOX_BACKOFF_MS=
# MATCH_OUTBOX_MAX_BACKOFF_MS=
# MATCH_OUTBOX_PUBLISH_TIMEOUT_MS=

# Chat policy for opt-in composition only; public activation remains gated.
# CHAT_MESSAGE_LIMIT=500
# CHAT_PAGE_LIMIT=50
# CHAT_SEND_LIMIT=10
# CHAT_READ_LIMIT=60
# Phase 17A2: a complete explicit transport admission profile is required in production.
# No production quotas/capacity are selected here. See docs/security/transport-admission.md.
# ADMISSION_HTTP_PER_MINUTE=
# ADMISSION_ENGINE_PER_MINUTE=
# ADMISSION_CONNECT_PER_MINUTE=
# ADMISSION_EVENT_PER_MINUTE=
# ADMISSION_HTTP_IN_FLIGHT=
# ADMISSION_ENGINE_IN_FLIGHT=
# ADMISSION_CONNECTIONS=
# ADMISSION_PENDING_PER_SOCKET=
# ADMISSION_PENDING_TOTAL=
# ADMISSION_SUBSCRIPTIONS=
