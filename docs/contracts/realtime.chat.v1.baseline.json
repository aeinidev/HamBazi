          "maximum": 50
        },
        "beforeSeq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "afterSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
