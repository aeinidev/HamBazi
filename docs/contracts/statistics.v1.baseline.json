    "/v1/me/stats": {
      "get": {
        "operationId": "readOwnStatistics",
        "description": "ACTIVE account and valid session required. Unknown/duplicate query fields fail validation. Statistics reads fail closed when the distributed limiter is unavailable. Results are eventually consistent; Monday 00:00 UTC weeks use durable finish time. Bot takeover credit remains with the original account. Counts and ranks are exact decimal strings.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["all_time", "weekly"],
              "default": "all_time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; no-store; decimal count/rank strings",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "period": {
                      "type": "string",
                      "pattern": "^(all_time|week:\\d{4}-\\d{2}-\\d{2})$"
                    },
                    "games": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "gameId": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,63}$"
                          },
                          "completed": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,18})$"
                          },
                          "wins": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,18})$"
                          },
                          "losses": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,18})$"
                          }
                        },
                        "required": ["gameId", "completed", "wins", "losses"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["schemaVersion", "period", "games"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Sanitized failure; 429 includes Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
