    "/v1/leaderboards/{game}": {
      "get": {
        "operationId": "readLeaderboard",
        "description": "ACTIVE account and valid session required. Unknown/duplicate query fields fail validation. Statistics reads fail closed when the distributed limiter is unavailable. Results are eventually consistent; Monday 00:00 UTC weeks use durable finish time. Bot takeover credit remains with the original account. Counts and ranks are exact decimal strings. Coup Wins only. Ties share competition ranks; opaque ID orders ties. Zero-win participants are included. Names of inactive accounts are replaced with Player. Pagination observes current aggregates and may drift; refresh to restart.",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "game",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["coup"]
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["all_time", "weekly"],
              "default": "all_time"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; no-store; decimal count/rank strings",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "schemaVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "gameId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "metric": {
                      "type": "string",
                      "const": "wins"
                    },
                    "period": {
                      "type": "string",
                      "pattern": "^(all_time|week:\\d{4}-\\d{2}-\\d{2})$"
                    },
                    "entries": {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "userId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "displayName": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "rank": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,18})$"
                          },
                          "wins": {
                            "type": "string",
                            "pattern": "^(0|[1-9][0-9]{0,18})$"
                          }
                        },
                        "required": ["userId", "displayName", "rank", "wins"],
                        "additionalProperties": false
                      }
                    },
                    "nextOffset": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "gameId",
                    "metric",
                    "period",
                    "entries",
                    "nextOffset"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
