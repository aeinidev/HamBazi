!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tsconfig*.json
!apps/
!apps/**
!packages/
!packages/**
!tooling/
!tooling/**
!infra/
!infra/docker/
!infra/docker/apps/
!infra/docker/apps/**
!.build-inputs/
!.build-inputs/*.apk
**/node_modules
**/dist
**/src/generated
**/tests
**/test-results
**/playwright-report
**/.turbo
**/.git
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.log
**/*.pid
**/*.tsbuildinfo
