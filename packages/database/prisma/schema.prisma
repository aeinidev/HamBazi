generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @db.Uuid
  telegramUserId          BigInt                   @unique @map("telegram_user_id")
  displayName             String                   @map("display_name")
  publicHandle            String                   @unique @map("public_handle")
  username                String?                  @unique
  profileAvatar           String?                  @map("profile_avatar")
  telegramUsername        String?                  @map("telegram_username")
  status                  String
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  registrationCompletedAt DateTime?                @map("registration_completed_at") @db.Timestamptz(3)
  authVersion             Int                      @default(0) @map("auth_version")
  profileVersion          Int                      @default(0) @map("profile_version")
  restrictions            UserRestriction[]
  profileReceipts         ProfileMutationReceipt[]
  settings                UserSettings?
  hostedRooms             Room[]
  roomMembers             RoomMember[]
  matchAdmissions         MatchAdmission[]
  matchPlayers            MatchPlayer[]
  events                  GameEvent[]
  results                 GameResult[]
  stats                   UserGameStats[]
  messages                ChatMessage[]
  commands                ProcessedCommand[]
  sessions                Session[]

  @@map("users")
}

model Session {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  authVersion   Int       @default(0) @map("auth_version")
  commandId     String    @map("command_id") @db.Uuid
  schemaVersion Int       @map("schema_version")
  keyId         String    @map("key_id")
  issuer        String
  audience      String
  issuedAt      DateTime  @map("issued_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, commandId])
  @@index([expiresAt])
  @@map("sessions")
}

model BotUpdateReceipt {
  id               String   @id @db.Uuid
  botId            BigInt   @map("bot_id")
  updateId         Int      @map("update_id")
  telegramUserId   BigInt   @map("telegram_user_id")
  messageId        Int      @map("message_id")
  replyToMessageId Int?     @map("reply_to_message_id")
  schemaVersion    Int      @map("schema_version")
  action           String
  phase            String
  version          Int
  receivedAt       DateTime @map("received_at") @db.Timestamptz(3)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  leaseUntil       DateTime @map("lease_until") @db.Timestamptz(3)
  replyData        Json?    @map("reply_data") @db.JsonB
  reply            String?
  flowId           String?  @map("flow_id") @db.Uuid
  promptVersion    Int?     @map("prompt_version")

  @@unique([botId, updateId])
  @@index([expiresAt])
  @@map("bot_update_receipts")
}

model BotOnboardingFlow {
  id                String   @id @db.Uuid
  botId             BigInt   @map("bot_id")
  telegramUserId    BigInt   @map("telegram_user_id")
  schemaVersion     Int      @map("schema_version")
  version           Int
  state             String
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  promptVersion     Int      @map("prompt_version")
  promptMessageId   Int?     @map("prompt_message_id")
  admittedReceiptId String?  @map("admitted_receipt_id") @db.Uuid

  @@unique([botId, telegramUserId])
  @@index([expiresAt])
  @@map("bot_onboarding_flows")
}

model UserSettings {
  userId        String   @id @map("user_id") @db.Uuid
  schemaVersion Int      @map("schema_version")
  settingsJsonb Json     @map("settings_jsonb") @db.JsonB
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_settings")
}

model ProfileMutationReceipt {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  commandId      String   @map("command_id") @db.Uuid
  requestDigest  String   @map("request_digest")
  appliedVersion Int      @map("applied_version")
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, commandId])
  @@index([expiresAt])
  @@map("profile_mutation_receipts")
}

model Game {
  id                  String          @id
  slug                String          @unique
  title               String
  minPlayers          Int             @map("min_players")
  maxPlayers          Int             @map("max_players")
  matchmakingEnabled  Boolean         @map("matchmaking_enabled")
  privateRoomsEnabled Boolean         @map("private_rooms_enabled")
  chatEnabled         Boolean         @map("chat_enabled")
  voiceEnabled        Boolean         @default(false) @map("voice_enabled")
  status              String
  configSchemaVersion Int             @map("config_schema_version")
  configJsonb         Json            @map("config_jsonb") @db.JsonB
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  rooms               Room[]
  matches             Match[]
  results             GameResult[]
  stats               UserGameStats[]

  admissions        MatchAdmission[]
  adminVersion      Int              @default(0) @map("admin_version")
  adminAvailability String           @default("ACTIVE") @map("admin_availability")

  @@map("games")
}

model Room {
  id              String               @id @db.Uuid
  gameId          String               @map("game_id")
  hostUserId      String               @map("host_user_id") @db.Uuid
  capacity        Int
  schemaVersion   Int                  @default(1) @map("schema_version")
  stateVersion    Int                  @default(0) @map("state_version")
  startedMatchId  String?              @unique @map("started_match_id") @db.Uuid
  commandReceipts RoomCommandReceipt[]
  inviteCode      String               @unique @map("invite_code")
  status          String
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  game            Game                 @relation(fields: [gameId], references: [id], onDelete: Restrict)
  host            User                 @relation(fields: [hostUserId], references: [id], onDelete: Restrict)
  members         RoomMember[]
  match           Match?

  @@index([status, expiresAt])
  @@map("rooms")
}

model RoomMember {
  roomId        String   @map("room_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  seat          Int
  joinedVersion Int      @default(0) @map("joined_version")
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
  @@unique([roomId, seat])
  @@index([userId])
  @@map("room_members")
}

model Match {
  id                   String             @id @db.Uuid
  gameId               String             @map("game_id")
  roomId               String?            @unique @map("room_id") @db.Uuid
  roomStartVersion     Int?               @map("room_start_version")
  matchType            String             @map("match_type")
  status               String
  engineVersion        String             @map("engine_version")
  stateSchemaVersion   Int                @map("state_schema_version")
  rulesetVersion       String             @map("ruleset_version")
  reconnectPolicyJsonb Json?              @map("reconnect_policy_jsonb") @db.JsonB
  stateJsonb           Json?              @map("state_jsonb") @db.JsonB
  stateVersion         Int                @default(0) @map("state_version")
  lastEventSeq         Int                @default(0) @map("last_event_seq")
  startedAt            DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?          @map("finished_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  game                 Game               @relation(fields: [gameId], references: [id], onDelete: Restrict)
  room                 Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  botSeats             MatchBotSeat[]
  players              MatchPlayer[]
  events               GameEvent[]
  commands             ProcessedCommand[]
  results              GameResult[]
  result               MatchResult?
  chatStream           ChatStream?
  messages             ChatMessage[]

  admissions  MatchAdmission[]
  reservation MatchReservation?

  @@unique([id, gameId])
  @@index([gameId, status, createdAt])
  @@map("matches")
}

model MatchPlayer {
  matchId              String                 @map("match_id") @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  seat                 Int
  agentType            String                 @map("agent_type")
  connectionStatus     String                 @map("connection_status")
  connectionEpoch      Int                    @default(0) @map("connection_epoch")
  disconnectDeadlineAt DateTime?              @map("disconnect_deadline_at") @db.Timestamptz(3)
  connections          MatchConnectionLease[]
  disconnectedAt       DateTime?              @map("disconnected_at") @db.Timestamptz(3)
  replacedAt           DateTime?              @map("replaced_at") @db.Timestamptz(3)
  readyAt              DateTime?              @map("ready_at") @db.Timestamptz(3)
  joinedAt             DateTime               @default(now()) @map("joined_at") @db.Timestamptz(3)
  match                Match                  @relation(fields: [matchId], references: [id], onDelete: Restrict)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([matchId, userId])
  @@unique([matchId, seat])
  @@index([userId, matchId])
  @@map("match_players")
}

model GameEvent {
  id            String   @id @db.Uuid
  matchId       String   @map("match_id") @db.Uuid
  seq           Int
  schemaVersion Int      @map("schema_version")
  type          String
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  payloadJsonb  Json     @map("payload_jsonb") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([matchId, seq])
  @@map("game_events")
}

model ProcessedCommand {
  matchId          String   @map("match_id") @db.Uuid
  actionId         String   @map("action_id") @db.Uuid
  actorUserId      String?  @map("actor_user_id") @db.Uuid
  schemaVersion    Int      @map("schema_version")
  expectedVersion  Int      @map("expected_version")
  resultingVersion Int      @map("resulting_version")
  requestDigest    String?  @map("request_digest") @db.Char(64)
  resultJsonb      Json     @map("result_jsonb") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor            User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@id([matchId, actionId])
  @@map("processed_commands")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  aggregateId   String    @map("aggregate_id") @db.Uuid
  type          String
  schemaVersion Int       @map("schema_version")
  payloadJsonb  Json      @map("payload_jsonb") @db.JsonB
  status        String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedUntil  DateTime? @map("claimed_until") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  requestId     String?   @map("request_id")
  traceparent   String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
  @@map("outbox_events")
}

model ConsumerReceipt {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("consumer_receipts")
}

model GameResult {
  matchId       String   @map("match_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  gameId        String   @map("game_id")
  placement     Int
  winner        Boolean
  schemaVersion Int      @map("schema_version")
  metricsJsonb  Json     @map("metrics_jsonb") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  match         Match    @relation(fields: [matchId, gameId], references: [id, gameId], onDelete: Restrict)
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([matchId, userId])
  @@index([userId, gameId, createdAt])
  @@map("game_results")
}

model UserGameStats {
  userId    String   @map("user_id") @db.Uuid
  gameId    String   @map("game_id")
  metric    String
  period    String
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@id([userId, gameId, metric, period])
  @@index([gameId, metric, period, value])
  @@map("user_game_stats")
}

model ChatStream {
  matchId String @id @map("match_id") @db.Uuid
  lastSeq Int    @default(0) @map("last_seq")
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@map("chat_streams")
}

model ChatMessage {
  id            String   @id @db.Uuid
  matchId       String   @map("match_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  schemaVersion Int      @map("schema_version")
  text          String
  commandId     String?  @map("command_id") @db.Uuid
  seq           Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matchId, userId, commandId])
  @@unique([matchId, seq])
  @@index([matchId, createdAt, id])
  @@map("chat_messages")
}

model RoomCommandReceipt {
  actorUserId    String   @map("actor_user_id") @db.Uuid
  commandId      String   @map("command_id") @db.Uuid
  roomId         String   @map("room_id") @db.Uuid
  requestDigest  String   @map("request_digest") @db.Char(64)
  appliedVersion Int      @map("applied_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@id([actorUserId, commandId])
  @@index([roomId])
  @@map("room_command_receipts")
}

// Matches-owned arbitration metadata, not durable queue ordering.
model MatchAdmission {
  id               String    @id @db.Uuid
  actorUserId      String    @map("actor_user_id") @db.Uuid
  commandId        String    @map("command_id") @db.Uuid
  gameId           String    @map("game_id")
  mode             String
  capacity         Int
  status           String
  activeKey        String?   @unique @map("active_key")
  generation       Int       @default(0)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  reservationId    String?   @map("reservation_id") @db.Uuid
  reservationUntil DateTime? @map("reservation_until") @db.Timestamptz(3)
  matchId          String?   @map("match_id") @db.Uuid

  schemaVersion Int               @default(1) @map("schema_version")
  actor         User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  game          Game              @relation(fields: [gameId], references: [id], onDelete: Restrict)
  match         Match?            @relation(fields: [matchId], references: [id], onDelete: Restrict)
  reservation   MatchReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([actorUserId, commandId])
  @@index([reservationId])
  @@map("match_admissions")
}

model MatchReservation {
  id            String    @id @db.Uuid
  requestDigest String    @map("request_digest") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(3)
  matchId       String?   @unique @map("match_id") @db.Uuid

  schemaVersion Int              @default(1) @map("schema_version")
  match         Match?           @relation(fields: [matchId], references: [id], onDelete: Restrict)
  admissions    MatchAdmission[]

  @@map("match_reservations")
}

// Minimal durable fencing metadata; raw Socket/session credentials are never stored.
model MatchConnectionLease {
  matchId          String      @map("match_id") @db.Uuid
  connectionId     String      @map("connection_id") @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  sessionExpiresAt DateTime    @map("session_expires_at") @db.Timestamptz(3)
  leaseUntil       DateTime    @map("lease_until") @db.Timestamptz(3)
  closedAt         DateTime?   @map("closed_at") @db.Timestamptz(3)
  player           MatchPlayer @relation(fields: [matchId, userId], references: [matchId, userId], onDelete: Restrict)

  @@id([matchId, connectionId])
  @@index([matchId, userId, leaseUntil])
  @@map("match_connection_leases")
}

// Matches owns immutable public result truth; engine state never enters this table.
model MatchResult {
  matchId      String @id @map("match_id") @db.Uuid
  eventId      String @unique @map("event_id") @db.Uuid
  ordinal      BigInt @unique @default(autoincrement())
  payloadJsonb Json   @map("payload_jsonb") @db.JsonB
  match        Match  @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@map("match_results")
}

// New projection tables leave the Phase 11B callback and its old composite key intact.
model StatsHead {
  id         String           @id
  activeId   String           @map("active_id") @db.Uuid
  buildingId String?          @map("building_id") @db.Uuid
  active     StatsGeneration  @relation("ActiveStats", fields: [activeId], references: [id], onDelete: Restrict)
  building   StatsGeneration? @relation("BuildingStats", fields: [buildingId], references: [id], onDelete: Restrict)

  @@map("stats_heads")
}

model StatsGeneration {
  id            String             @id @db.Uuid
  status        String
  createdAt     DateTime           @map("created_at") @db.Timestamptz(3)
  activeHeads   StatsHead[]        @relation("ActiveStats")
  buildingHeads StatsHead[]        @relation("BuildingStats")
  applications  StatsApplication[]
  values        StatsValue[]

  @@map("stats_generations")
}

model StatsApplication {
  generationId String          @map("generation_id") @db.Uuid
  matchId      String          @map("match_id") @db.Uuid
  digest       String          @db.Char(64)
  generation   StatsGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)

  @@id([generationId, matchId])
  @@map("stats_applications")
}

model StatsValue {
  generationId String          @map("generation_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  gameId       String          @map("game_id")
  metric       String
  period       String
  value        BigInt
  generation   StatsGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)

  @@id([generationId, userId, gameId, metric, period])
  @@index([generationId, gameId, metric, period, value, userId])
  @@map("stats_values")
}

// Server actors have no User or Telegram identity. Durable membership belongs to Matches.
model MatchBotSeat {
  matchId String @map("match_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  seat    Int
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@id([matchId, actorId])
  @@unique([matchId, seat])
  @@map("match_bot_seats")
}

model BotSupportSubmission {
  id                String   @id @db.Uuid
  botId             BigInt   @map("bot_id")
  telegramUserId    BigInt   @map("telegram_user_id")
  receiptId         String   @unique @map("receipt_id") @db.Uuid
  profileId         String   @map("profile_id") @db.Uuid
  displayName       String   @map("display_name")
  text              String
  adminChatId       BigInt   @map("admin_chat_id")
  status            String
  attemptVersion    Int      @default(0) @map("attempt_version")
  leaseUntil        DateTime @map("lease_until") @db.Timestamptz(3)
  deliveryMessageId Int?     @map("delivery_message_id")
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)

  @@index([botId, telegramUserId, status])
  @@map("bot_support_submissions")
}

// Admin identity is independent of Telegram/player accounts. Runtime tables have separate grants.
model AdminRealm {
  id             String            @id
  ownerId        String?           @unique @map("owner_id") @db.Uuid
  ownershipEpoch Int               @default(0) @map("ownership_epoch")
  policyRevision Int               @default(1) @map("policy_revision")
  owner          AdminOperator?    @relation("AdminRealmOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "admin_root_fk")
  operators      AdminOperator[]   @relation("AdminRealmOperators")
  sessions       AdminSession[]
  grants         AdminGrant[]
  auditEvents    AdminAuditEvent[]
  roles          AdminRole[]

  @@map("admin_realms")
}

model AdminOperator {
  id                   String              @id @db.Uuid
  realmId              String              @map("realm_id")
  username             String
  passwordVerifier     String              @map("password_verifier")
  pinVerifier          String?             @map("pin_verifier")
  credentialVersion    Int                 @map("credential_version")
  sessionEpoch         Int                 @map("session_epoch")
  authorizationVersion Int                 @map("authorization_version")
  status               String
  pinFailures          Int                 @default(0) @map("pin_failures")
  lockedAt             DateTime?           @map("locked_at") @db.Timestamptz(3)
  realm                AdminRealm          @relation("AdminRealmOperators", fields: [realmId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ownedRealm           AdminRealm?         @relation("AdminRealmOwner")
  sessions             AdminSession[]
  authReceipts         AdminAuthReceipt[]
  grants               AdminGrant[]
  roleMemberships      AdminOperatorRole[]
  operations           AdminOperation[]

  @@unique([realmId, username])
  @@unique([id, realmId], map: "admin_operators_id_realm_key")
  @@map("admin_operators")
}

model AdminSession {
  id                String             @id @db.Uuid
  realmId           String             @map("realm_id")
  operatorId        String             @map("operator_id") @db.Uuid
  kind              String
  credentialVersion Int                @map("credential_version")
  sessionEpoch      Int                @map("session_epoch")
  issuedAt          DateTime           @map("issued_at") @db.Timestamptz(3)
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(3)
  lastSeenAt        DateTime           @map("last_seen_at") @db.Timestamptz(3)
  revokedAt         DateTime?          @map("revoked_at") @db.Timestamptz(3)
  realm             AdminRealm         @relation(fields: [realmId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operator          AdminOperator      @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  authReceipts      AdminAuthReceipt[]

  @@index([operatorId, expiresAt])
  @@map("admin_sessions")
}

model AdminAuthReceipt {
  operatorId String        @map("operator_id") @db.Uuid
  commandId  String        @map("command_id") @db.Uuid
  digest     String        @db.Char(64)
  outcome    String
  sessionId  String?       @map("session_id") @db.Uuid
  operator   AdminOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  session    AdminSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([operatorId, commandId])
  @@map("admin_auth_receipts")
}

model AdminGrant {
  id          String        @id @db.Uuid
  realmId     String        @map("realm_id")
  operatorId  String        @map("operator_id") @db.Uuid
  permission  String
  environment String
  allGames    Boolean       @default(false) @map("all_games")
  gameIds     String[]      @map("game_ids")
  deny        Boolean       @default(false)
  realm       AdminRealm    @relation(fields: [realmId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operator    AdminOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([operatorId, realmId])
  @@map("admin_grants")
}

model AdminAuditEvent {
  id         String     @id @db.Uuid
  realmId    String     @map("realm_id")
  operatorId String?    @map("operator_id") @db.Uuid
  commandId  String     @map("command_id") @db.Uuid
  event      String
  occurredAt DateTime   @map("occurred_at") @db.Timestamptz(3)
  operation  String?
  targetId   String?    @map("target_id")
  reasonCode String?    @map("reason_code")
  mode       String?
  realm      AdminRealm @relation(fields: [realmId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([realmId, occurredAt, id])
  @@index([realmId, operatorId, occurredAt, id], map: "admin_audit_actor_idx")
  @@index([realmId, targetId, occurredAt, id], map: "admin_audit_target_idx")
  @@map("admin_audit_events")
}

model AdminRole {
  id          String              @id @db.Uuid
  realmId     String              @map("realm_id")
  name        String
  version     Int
  grantsJsonb Json                @map("grants_jsonb")
  realm       AdminRealm          @relation(fields: [realmId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "admin_roles_realm_fk")
  memberships AdminOperatorRole[]

  @@unique([realmId, name])
  @@unique([id, realmId], map: "admin_roles_id_realm_key")
  @@map("admin_roles")
}

model AdminOperatorRole {
  operatorId String        @map("operator_id") @db.Uuid
  roleId     String        @map("role_id") @db.Uuid
  realmId    String        @map("realm_id")
  operator   AdminOperator @relation(fields: [operatorId, realmId], references: [id, realmId], onDelete: Restrict, onUpdate: NoAction, map: "admin_membership_operator_fk")
  role       AdminRole     @relation(fields: [roleId, realmId], references: [id, realmId], onDelete: Restrict, onUpdate: NoAction, map: "admin_membership_role_fk")

  @@id([operatorId, roleId])
  @@map("admin_operator_roles")
}

model AdminOperation {
  id                           String        @id @db.Uuid
  realmId                      String        @map("realm_id")
  actorId                      String        @map("actor_id") @db.Uuid
  sessionId                    String        @map("session_id") @db.Uuid
  authorizationVersion         Int           @map("authorization_version")
  credentialVersion            Int           @map("credential_version")
  sessionEpoch                 Int           @map("session_epoch")
  policyRevision               Int           @map("policy_revision")
  ownershipEpoch               Int           @map("ownership_epoch")
  environment                  String
  digest                       String        @db.Char(64)
  action                       Json
  gameId                       String?       @map("game_id")
  privateNoteCiphertext        String?       @map("private_note_ciphertext")
  reasonCode                   String        @map("reason_code")
  state                        String
  mode                         String?
  approverId                   String?       @map("approver_id") @db.Uuid
  approverSessionId            String?       @map("approver_session_id") @db.Uuid
  approverAuthorizationVersion Int?          @map("approver_authorization_version")
  approverSessionEpoch         Int?          @map("approver_session_epoch")
  approverCredentialVersion    Int?          @map("approver_credential_version")
  createdAt                    DateTime      @map("created_at") @db.Timestamptz(3)
  expiresAt                    DateTime      @map("expires_at") @db.Timestamptz(3)
  approvedUntil                DateTime?     @map("approved_until") @db.Timestamptz(3)
  resultCode                   String?       @map("result_code")
  actor                        AdminOperator @relation(fields: [actorId, realmId], references: [id, realmId], onDelete: Restrict, onUpdate: NoAction, map: "admin_operations_actor_fk")

  @@index([realmId, state, createdAt])
  @@index([realmId, actorId, createdAt])
  @@map("admin_operations")
}

